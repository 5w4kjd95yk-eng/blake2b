FROM rust:1.84-bookworm AS builder

ARG MEMPOOL_GUIDE_COMMIT
ARG MEMPOOL_GUIDE_TARBALL_SHA256
ARG GEOIP_COMMIT
ARG GEOIP_CITY_SHA256
ARG GEOIP_ASN_SHA256

ENV MEMPOOL_COMMIT_HASH=${MEMPOOL_GUIDE_COMMIT}
ENV FD=/src/backend/rust-gbt
ENV PATH=/usr/local/cargo/bin:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl --fail --silent --show-error --location \
      https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends \
      build-essential \
      nodejs=24.13.0-1nodesource1 \
      pkg-config \
      python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN curl --fail --location --retry 3 \
      "https://github.com/Retropex/mempool/archive/${MEMPOOL_GUIDE_COMMIT}.tar.gz" \
      --output /tmp/mempool-guide.tar.gz \
    && echo "${MEMPOOL_GUIDE_TARBALL_SHA256}  /tmp/mempool-guide.tar.gz" \
      | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/mempool-guide.tar.gz \
      --strip-components=1 \
    && rm /tmp/mempool-guide.tar.gz \
    && cp docker/backend/* backend/ \
    && mkdir -p backend/GeoIP \
    && curl --fail --location --retry 3 \
      "https://raw.githubusercontent.com/mempool/geoip-data/${GEOIP_COMMIT}/GeoLite2-City.mmdb" \
      --output backend/GeoIP/GeoLite2-City.mmdb \
    && curl --fail --location --retry 3 \
      "https://raw.githubusercontent.com/mempool/geoip-data/${GEOIP_COMMIT}/GeoLite2-ASN.mmdb" \
      --output backend/GeoIP/GeoLite2-ASN.mmdb \
    && echo "${GEOIP_CITY_SHA256}  backend/GeoIP/GeoLite2-City.mmdb" \
      | sha256sum --check --strict \
    && echo "${GEOIP_ASN_SHA256}  backend/GeoIP/GeoLite2-ASN.mmdb" \
      | sha256sum --check --strict

WORKDIR /src/backend

RUN npm ci --omit=dev --omit=optional \
    && npm run package

FROM rust:1.84-bookworm AS runtime

ARG MEMPOOL_GUIDE_COMMIT

LABEL org.opencontainers.image.source="https://github.com/Retropex/mempool" \
      org.opencontainers.image.revision="${MEMPOOL_GUIDE_COMMIT}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl --fail --silent --show-error --location \
      https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs=24.13.0-1nodesource1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /backend

COPY --from=builder --chown=1000:1000 /src/backend/package ./package/
COPY --from=builder --chown=1000:1000 /src/backend/GeoIP ./GeoIP/
COPY --from=builder --chown=1000:1000 /src/backend/start.sh /src/backend/wait-for-it.sh ./

USER 1000

EXPOSE 8999

CMD ["/backend/start.sh"]
