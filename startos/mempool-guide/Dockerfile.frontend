FROM node:24.13-bookworm-slim AS builder

ARG MEMPOOL_GUIDE_COMMIT
ARG MEMPOOL_GUIDE_TARBALL_SHA256

ENV CYPRESS_INSTALL_BINARY=0
ENV DOCKER_COMMIT_HASH=${MEMPOOL_GUIDE_COMMIT}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      gettext-base \
      rsync \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN curl --fail --location --retry 3 \
      "https://github.com/Retropex/mempool/archive/${MEMPOOL_GUIDE_COMMIT}.tar.gz" \
      --output /tmp/mempool-guide.tar.gz \
    && echo "${MEMPOOL_GUIDE_TARBALL_SHA256}  /tmp/mempool-guide.tar.gz" \
      | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/mempool-guide.tar.gz \
      --strip-components=1 \
    && rm /tmp/mempool-guide.tar.gz \
    && cp docker/frontend/* frontend/ \
    && cp nginx.conf nginx-mempool.conf frontend/ \
    && sed -i -e 's/127\.0\.0\.1:80/0.0.0.0:__MEMPOOL_FRONTEND_HTTP_PORT__/g' frontend/nginx.conf \
    && sed -i -e 's/127\.0\.0\.1/0.0.0.0/g' frontend/nginx.conf \
    && sed -i -e 's/user nobody;//g' frontend/nginx.conf \
    && sed -i -e 's!/etc/nginx/nginx-mempool.conf!/etc/nginx/conf.d/nginx-mempool.conf!g' frontend/nginx.conf \
    && sed -i -e 's/127\.0\.0\.1:8999/__MEMPOOL_BACKEND_MAINNET_HTTP_HOST__:__MEMPOOL_BACKEND_MAINNET_HTTP_PORT__/g' frontend/nginx-mempool.conf

WORKDIR /src/frontend

RUN cp mempool-frontend-config.sample.json mempool-frontend-config.json \
    && npm ci --omit=dev --omit=optional \
    && npm run build

FROM nginx:1.27.0-alpine

ARG MEMPOOL_GUIDE_COMMIT

LABEL org.opencontainers.image.source="https://github.com/Retropex/mempool" \
      org.opencontainers.image.revision="${MEMPOOL_GUIDE_COMMIT}"

WORKDIR /patch

COPY --from=builder /src/frontend/entrypoint.sh .
COPY --from=builder /src/frontend/wait-for .
COPY --from=builder /src/frontend/dist/mempool /var/www/mempool
COPY --from=builder /src/frontend/nginx.conf /etc/nginx/
COPY --from=builder /src/frontend/nginx-mempool.conf /etc/nginx/conf.d/

RUN chmod +x /patch/entrypoint.sh /patch/wait-for \
    && chown -R 1000:1000 /patch /var/cache/nginx /var/log/nginx \
      /etc/nginx/nginx.conf /etc/nginx/conf.d /var/www/mempool \
    && touch /var/run/nginx.pid \
    && chown 1000:1000 /var/run/nginx.pid

USER 1000

ENTRYPOINT ["/patch/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]

